{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Edge device telemetry",
  "type": "object",
  "additionalProperties": false,
  "required": ["device_id", "timestamp_ms", "sequence", "readings"],
  "properties": {
    "device_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "timestamp_ms": {"type": "integer", "minimum": 0},
    "sequence": {"type": "integer", "minimum": 0},
    "readings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["temperature_c", "humidity_rh_pct"],
      "properties": {
        "temperature_c": {"type": "number", "minimum": -40, "maximum": 125},
        "humidity_rh_pct": {"type": "number", "minimum": 0, "maximum": 100},
        "distance_cm": {"type": "number", "minimum": 0}
      }
    },
    "status": {"type": "string", "enum": ["ok", "warning", "fault"]}
  }
}
